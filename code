# Generate bus data
def generate_buses():
    buses = []
    routes = [
        ("New York", "Boston", "08:00 AM", "4h", 45, ['AC', 'WiFi', 'Snacks']),
        ("New York", "Washington DC", "09:30 AM", "5h", 55, ['AC', 'WiFi', 'Water Bottle']),
        ("Boston", "New York", "10:00 AM", "4h", 45, ['AC', 'USB Ports', 'Snacks']),
        ("New York", "Chicago", "11:00 PM", "12h", 85, ['Sleeper', 'AC', 'Meal']),
        ("Los Angeles", "San Francisco", "07:00 AM", "6h", 65, ['AC', 'WiFi', 'Entertainment']),
        ("Chicago", "New York", "08:30 PM", "12h", 85, ['Sleeper', 'AC', 'WiFi']),
    ]

    for i, (frm, to, time, duration, price, amenities) in enumerate(routes, 1):
        seats = []
        for j in range(1, 41):
            # 70% available, 30% booked for demo
            status = 'available' if random.random() > 0.3 else 'booked'
            seats.append({'number': j, 'status': status})

        buses.append({
            'id': i,
            'name': f"Express {i}",
            'from': frm,
            'to': to,
            'time': time,
            'duration': duration,
            'price': price,
            'amenities': amenities,
            'seats': seats
        })
    return buses

buses_data = generate_buses()

@app.route('/')
def index():
    return render_template_string(HTML_TEMPLATE)

@app.route('/search', methods=['POST'])
def search():
    from_city = request.form.get('from_city')
    to_city = request.form.get('to_city')

    matching_buses = [
        bus for bus in buses_data
        if bus['from'] == from_city and bus['to'] == to_city
    ]

    # Return only bus info (without seat details for performance)
    result = [{
        'id': bus['id'],
        'name': bus['name'],
        'from': bus['from'],
        'to': bus['to'],
        'time': bus['time'],
        'duration': bus['duration'],
        'price': bus['price'],
        'amenities': bus['amenities']
    } for bus in matching_buses]

    return jsonify(result)

@app.route('/bus/<int:bus_id>')
def get_bus(bus_id):
    bus = next((b for b in buses_data if b['id'] == bus_id), None)
    if bus:
        return jsonify(bus)
    return jsonify({'error': 'Bus not found'}), 404

@app.route('/book', methods=['POST'])
def book():
    data = request.json
    bus_id = data.get('bus_id')
    seats = data.get('seats', [])

    bus = next((b for b in buses_data if b['id'] == bus_id), None)
    if not bus:
        return jsonify({'message': 'Bus not found'}), 404

    # Mark seats as booked
    for seat in bus['seats']:
        if str(seat['number']) in seats and seat['status'] == 'available':
            seat['status'] = 'booked'

    total_amount = len(seats) * bus['price']
    return jsonify({
        'message': f'✅ Booking Confirmed! {len(seats)} seat(s) booked. Total: ₹{total_amount}'
    })

